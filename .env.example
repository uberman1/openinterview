# AI Provider Configuration
# Options: 'openrouter', 'gemini', 'openai'
RESUME_AI_PROVIDER=openrouter

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=mistralai/devstral-2512:free

# DeepSeek Configuration (Optional)
# Set USE_REAL_DEEPSEEK=true to use DeepSeek API directly instead of OpenRouter
USE_REAL_DEEPSEEK=false
DEEPSEEK_API_KEY=your_deepseek_api_key

# ===========================================
# SMS Provider (Twilio or equivalent)
# ===========================================
# Options: 'mock' (no real SMS) | 'twilio'
SMS_PROVIDER=mock

# Twilio credentials (used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio "From" phone number that is verified for SMS.
# Use E.164 format, e.g. +14155551234
TWILIO_PHONE_NUMBER=+14155551234

# Optional: public HTTPS endpoint for delivery status callbacks.
# (Twilio will call this URL; we can log delivery status later.)
SMS_STATUS_WEBHOOK_URL=https://your-domain.com/sms/status-webhook

# Dashboard sale banner Upgrade button → POST /api/checkout with this plans.code
DASHBOARD_SALE_PLAN_CODE=pro
